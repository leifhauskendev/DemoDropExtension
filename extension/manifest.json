{
  "manifest_version": 3,
  "name": "DemoDrop",
  "version": "0.2.1",
  "description": "Downloads CS2 demos from HLTV and FACEIT match pages and drops them straight into your CS2 folder.",
  "key": "",
  "permissions": ["downloads", "nativeMessaging", "notifications", "storage"],
  "host_permissions": [
    "https://www.hltv.org/*",
    "https://*.hltv.org/*",
    "https://www.faceit.com/*",
    "https://*.faceit-cdn.net/*",
    "https://play.refrag.gg/*",
    "https://api-k8s.refrag.gg/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.hltv.org/matches/*"],
      "js": ["content-hltv.js"],
      "css": ["content.css"]
    },
    {
      "matches": ["https://www.faceit.com/*"],
      "js": ["content-faceit.js"],
      "css": ["content.css"]
    },
    {
      "matches": ["https://play.refrag.gg/*"],
      "js": ["content-refrag.js"]
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "DemoDrop settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
